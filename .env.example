# ---------------------------------------------------------------------------
# Digital Grow Bazaar — environment
# Copy to .env and fill in. The site runs WITHOUT Supabase (it falls back
# to built-in seed content); Supabase unlocks the admin panel + dynamic data.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_…) — SERVER ONLY. Never expose with NEXT_PUBLIC_.
# Used by the contact form to insert inquiries and by admin write actions.
SUPABASE_SECRET_KEY=

# Legacy key names are still accepted, for projects created before Supabase
# renamed anon → publishable and service_role → secret. Use either pair:
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=
#   SUPABASE_SERVICE_ROLE_KEY=

# Optional analytics / verification (also settable in Admin → Site settings)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
